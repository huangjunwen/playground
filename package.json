{
  "name": "playground",
  "private": true,
  "version": "0.0.0",
  "description": "My Web App Playground",
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:web": "vitest run --project web",
    "test:watch": "vitest",
    "bench": "pnpm bench:node && pnpm bench:web",
    "bench:node": "vitest bench --run --project node --no-file-parallelism",
    "bench:web": "vitest bench --run --project web --no-file-parallelism",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^22.10.0",
    "@vitest/browser": "^3.2.7",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
