{
  "name": "@playground/agda-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run --root ../.. apps/agda-editor",
    "test:node": "vitest run --root ../.. --project node apps/agda-editor",
    "test:web": "vitest run --root ../.. --project web apps/agda-editor"
  },
  "dependencies": {
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@playground/language-backend-agda": "workspace:*",
    "@playground/lsp": "workspace:*",
    "@playground/run-env": "workspace:*",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
