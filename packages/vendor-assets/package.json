{
  "name": "@playground/vendor-assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "ensure": "node src/scripts/ensure-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/vendor-assets",
