{
  "name": "@playground/language-backend-agda",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/language-backend-agda",
    "test:watch": "vitest --root ../.. packages/language-backend-agda",
    "bench:node": "vitest bench --run --root ../.. --project node packages/language-backend-agda/tests/benchmark/cmdLoad.bench-node.ts",
    "bench:web": "vitest bench --run --root ../.. --project web packages/language-backend-agda/tests/benchmark/cmdLoad.bench-web.ts",
    "profile:dev": "vite --config profile-ui/vite.config.ts"
  },
  "dependencies": {
    "@playground/lsp": "workspace:*",
    "@playground/run-env": "workspace:*",
    "@playground/vendor-assets": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
